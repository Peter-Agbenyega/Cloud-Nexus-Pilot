# CloudNexus Pilot Phase 1 foundation
# Copy this file to `.env` at repo root for local development.

# Root metadata
GITHUB_REPOSITORY_NAME=CloudNexus-Pilot

# API runtime
NODE_ENV=development
PORT=10000
# Production: https://cloudnexuspilot.com,https://www.cloudnexuspilot.com
CORS_ORIGIN=http://localhost:3000
# Set to "supabase" in production for real JWT verification
AUTH_MODE=mock

# Database mode (sqlite for local MVP, postgres for integration)
DB_PROVIDER=sqlite
SQLITE_FILE=./packages/db/.data/dev.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cloudnexus

# Supabase (backend uses server-side keys; frontend uses NEXT_PUBLIC_ variants)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Frontend-only (set in Vercel, not here):
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Queue scaffold (optional in Phase 1)
UPSTASH_REDIS_URL=

# AI keys
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
AI_DAILY_BUDGET_USD=20

# Error tracking (optional)
SENTRY_DSN=
