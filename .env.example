# Cloud Nexus Pilot Environment Template
# Copy this file to `.env` for local monorepo/API development.
# Copy app-specific values to `apps/cloud-nexus-pilot/.env.local` for local Next.js development.
# Do not commit real secrets. Configure production values in Vercel, Render, and Supabase dashboards.

# =============================================================================
# Repository metadata
# =============================================================================
GITHUB_REPOSITORY_NAME=Cloud-Nexus-Pilot

# =============================================================================
# Local API runtime / Render web service
# Used by `apps/api` and root scripts such as `npm run dev`.
# =============================================================================
NODE_ENV=development
PORT=10000

# Local frontend origin for API CORS.
CORS_ORIGIN=http://localhost:3000

# Production Render example:
# CORS_ORIGIN=https://cloudnexuspilot.com,https://www.cloudnexuspilot.com,https://cloud-nexus-pilot-cloud-nexus-pilot.vercel.app

# Local development can use mock auth.
# Production should use: supabase
AUTH_MODE=mock

# =============================================================================
# Database
# Local default: SQLite.
# Production API backend: PostgreSQL.
# =============================================================================
DB_PROVIDER=sqlite
SQLITE_FILE=./packages/db/.data/dev.db

# Required only when DB_PROVIDER=postgres.
DATABASE_URL=

# =============================================================================
# Supabase
# Frontend auth uses NEXT_PUBLIC_* values.
# Backend/API verification uses server-side values.
# Never expose SUPABASE_SERVICE_ROLE_KEY in browser/client code.
# =============================================================================

# Server-side Supabase project URL.
SUPABASE_URL=https://wwhxaligcyqpnpdfxynr.supabase.co

# Server-side only. Use the Supabase secret/service-role key only in trusted backend code.
SUPABASE_SERVICE_ROLE_KEY=

# Optional backend anon/publishable key for API middleware helpers.
SUPABASE_ANON_KEY=

# Next.js browser-safe Supabase values.
# In this app, NEXT_PUBLIC_SUPABASE_ANON_KEY should receive the Supabase publishable key.
NEXT_PUBLIC_SUPABASE_URL=https://wwhxaligcyqpnpdfxynr.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# =============================================================================
# Vercel / Next.js public app settings
# Only variables prefixed with NEXT_PUBLIC_ are exposed to browser code.
# =============================================================================

# Local development:
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Cloud Nexus Pilot
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Production examples:
# NEXT_PUBLIC_SITE_URL=https://cloudnexuspilot.com
# NEXT_PUBLIC_API_BASE_URL=https://cloudnexuspilot.com

# =============================================================================
# OpenAI
# Server-side only. Do not prefix OPENAI_API_KEY with NEXT_PUBLIC_.
# Required for:
# - /api/detect-question
# - /api/generate-guidance
# - /api/transcribe
# - live transcription chunks
# =============================================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Optional budget/reporting guardrails for API services.
AI_DAILY_BUDGET_USD=20

# =============================================================================
# Optional platform services
# =============================================================================
UPSTASH_REDIS_URL=
SENTRY_DSN=

# =============================================================================
# Local transcription test helpers
# =============================================================================
CLOUD_NEXUS_TEST_BASE_URL=http://127.0.0.1:3000
TRANSCRIBE_TEST_TIMEOUT_MS=30000
STREAMING_TEST_TIMEOUT_MS=15000
