{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:deps": "npm run build --workspace @cloudnexus/shared && npm run build --workspace @cloudnexus/db",
    "dev": "npm run build:deps && npm run build && node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "npm run build:deps && tsc -p tsconfig.json --noEmit",
    "lint": "echo 'api: no lint configured'"
  },
  "dependencies": {
    "@cloudnexus/db": "0.1.0",
    "@cloudnexus/shared": "0.1.0",
    "@fastify/cors": "^11.1.0",
    "fastify": "^5.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
