# Cloud Nexus Pilot Next.js app environment template
# Copy to `apps/cloud-nexus-pilot/.env.local` for local app development.
# Configure these same values in the Vercel project for Preview and Production.
# Do not commit real secret values.

# -----------------------------------------------------------------------------
# Public app settings
# NEXT_PUBLIC_* values are bundled into browser code.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Cloud Nexus Pilot

# Local API scaffold default. Use the production API origin in Vercel.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8010
# Local authenticated realtime WebSocket endpoint. Use ws:// only for local dev.
# Production must use wss:// and JWTs must never be placed in the URL query string.
NEXT_PUBLIC_PILOT_REALTIME_WS_URL=ws://localhost:3010/ws/session
# Production example:
# NEXT_PUBLIC_SITE_URL=https://cloudnexuspilot.com
# NEXT_PUBLIC_API_BASE_URL=https://api.cloudnexuspilot.com
# NEXT_PUBLIC_PILOT_REALTIME_WS_URL=wss://realtime.cloudnexuspilot.com/ws/session

# -----------------------------------------------------------------------------
# Supabase browser auth
# Required for login/signup and authenticated Prompt Vault / transcript sync.
# The URL is public. The anon/publishable key is safe for browser use.
# Do not use the service-role key in Vercel frontend variables.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://api.cloudnexuspilot.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# -----------------------------------------------------------------------------
# AI server-side routes on Vercel
# OpenAI is required for live guidance. OpenAI is also used for AI question
# detection and transcription fallback when configured.
# Deepgram is used first for live transcription when configured.
# These are read only by Next.js route handlers and must not be NEXT_PUBLIC_*.
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
DEEPGRAM_API_KEY=

# -----------------------------------------------------------------------------
# Optional local test helpers
# -----------------------------------------------------------------------------
CLOUD_NEXUS_TEST_BASE_URL=http://127.0.0.1:3000
TRANSCRIBE_TEST_TIMEOUT_MS=30000
STREAMING_TEST_TIMEOUT_MS=15000
