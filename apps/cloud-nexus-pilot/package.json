{
  "name": "cloud-nexus-pilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:realtime && npm run test:intelligence && npm run test:routes && npm run test:connectivity && npm run test:provider-routes && npm run test:transcription-errors && npm run test:report-persistence && npm run test:security-boundary && npm run test:provider-diagnostics",
    "test:report-persistence": "node --test scripts/test-interview-report-persistence.mjs",
    "test:realtime": "tsc -p tsconfig.test.json && node --test dist/realtime-tests/tests/realtime/*.test.js",
    "test:intelligence": "tsc -p tsconfig.test.json && node --test dist/realtime-tests/tests/intelligence/*.test.js",
    "test:transcribe": "node ./scripts/test-transcribe.mjs",
    "test:streaming": "node ./scripts/test-streaming-session.mjs",
    "test:routes": "tsc -p tsconfig.test.json && node --test dist/realtime-tests/tests/routes/*.test.js",
    "test:connectivity": "node --test scripts/test-supabase-connectivity.mjs",
    "test:provider-routes": "node --test scripts/test-provider-routes.mjs",
    "test:transcription-errors": "node --test scripts/test-transcription-errors.mjs",
    "test:security-boundary": "node --test scripts/test-security-boundary.mjs",
    "test:provider-diagnostics": "node --test scripts/test-provider-diagnostics.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.99.0",
    "@tabler/icons-react": "^3.44.0",
    "mammoth": "^1.12.2",
    "next": "15.5.28",
    "pdf-parse": "^2.4.5",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "15.5.28",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/parser": "8.57.1",
    "autoprefixer": "^10.4.21",
    "eslint": "10.13.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.8.2"
  }
}
