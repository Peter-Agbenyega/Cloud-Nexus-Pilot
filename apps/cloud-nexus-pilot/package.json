{
  "name": "cloud-nexus-pilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:realtime && npm run test:intelligence",
    "test:realtime": "tsc -p tsconfig.test.json && node --test dist/realtime-tests/tests/realtime/*.test.js",
    "test:intelligence": "tsc -p tsconfig.test.json && node --test dist/realtime-tests/tests/intelligence/*.test.js",
    "test:transcribe": "node ./scripts/test-transcribe.mjs",
    "test:streaming": "node ./scripts/test-streaming-session.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.99.0",
    "@tabler/icons-react": "^3.44.0",
    "mammoth": "^1.12.2",
    "next": "^15.2.6",
    "pdf-parse": "^2.4.5",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "15.2.6",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.22.0",
    "eslint-config-next": "15.2.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "postcss": "^8.5.8",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.8.2"
  }
}
