{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "noEmit": false,
    "outDir": "dist/realtime-tests",
    "rootDir": ".",
    "types": ["node"],
    "verbatimModuleSyntax": false
  },
  "include": [
    "lib/realtime/**/*.ts",
    "lib/interview-intelligence/**/*.ts",
    "tests/realtime/**/*.test.ts",
    "tests/intelligence/**/*.test.ts"
  ]
}
