NODE_ENV=production
HOST=0.0.0.0
PORT=3010

# Comma-separated frontend origins allowed to connect.
# Production must list explicit origins; do not use wildcard CORS in production.
CORS_ORIGIN=https://cloudnexuspilot.com,https://www.cloudnexuspilot.com

# WebSocket runtime protection.
WS_MAX_PAYLOAD_BYTES=65536
WS_MAX_CONNECTIONS=100
WS_MAX_CONNECTIONS_PER_IP=10
WS_HEARTBEAT_INTERVAL_MS=30000
WS_IDLE_TIMEOUT_MS=300000
WS_SHUTDOWN_GRACE_MS=10000

# Trusted reverse proxy IP/CIDR allowlist for deriving request.ip from X-Forwarded-For.
# Leave empty unless this service is reachable only through one deliberately configured
# local reverse proxy that overwrites inbound X-Forwarded-* headers before proxying.
# Default is disabled, so direct requests cannot spoof their IP with X-Forwarded-For.
WS_TRUSTED_PROXY_CIDRS=

# Add real values only inside the private .env file on Hetzner.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEEPGRAM_API_KEY=
