GOTRUE_SITE_URL=https://REPLACE_VERIFIED_PILOT_WEB_HOST
GOTRUE_URI_ALLOW_LIST=https://REPLACE_VERIFIED_PILOT_WEB_HOST/auth/callback
GOTRUE_DISABLE_SIGNUP=true
GOTRUE_JWT_ADMIN_ROLES=service_role
GOTRUE_JWT_AUD=authenticated
GOTRUE_JWT_DEFAULT_GROUP_NAME=authenticated
GOTRUE_JWT_EXP=3600
GOTRUE_JWT_SECRET=REPLACE_PRIVATE_SIGNING_MATERIAL_AFTER_CONTINUITY_REVIEW
GOTRUE_JWT_ISSUER=https://REPLACE_IDENTITY_HOST/auth/v1
GOTRUE_EXTERNAL_EMAIL_ENABLED=true
GOTRUE_MAILER_AUTOCONFIRM=false
GOTRUE_EXTERNAL_PHONE_ENABLED=false
GOTRUE_EXTERNAL_ANONYMOUS_USERS_ENABLED=false
GOTRUE_SECURITY_REFRESH_TOKEN_ROTATION_ENABLED=true
GOTRUE_SECURITY_REFRESH_TOKEN_REUSE_INTERVAL=0
GOTRUE_DB_MAX_POOL_SIZE=5
