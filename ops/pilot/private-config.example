PGHOST=db
PGPORT=5432
PGDATABASE=pilot
PGUSER=postgres
PGPASSWORD=REPLACE_PRIVATE_ADMIN_PASSWORD
# auth.env
GOTRUE_API_HOST=0.0.0.0
GOTRUE_API_PORT=9999
API_EXTERNAL_URL=https://REPLACE_IDENTITY_HOST/auth/v1
GOTRUE_DB_DRIVER=postgres
