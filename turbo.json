{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "lint": {
      "outputs": []
    },
    "typecheck": {
      "dependsOn": [
        "^build"
      ],
      "outputs": []
    },
    "build": {
      "dependsOn": [
        "^build"
      ],
      "env": [
        "ANTHROPIC_API_KEY",
        "ANTHROPIC_MODEL",
        "DEEPGRAM_API_KEY",
        "LLM_PROVIDER",
        "NEXT_PUBLIC_API_BASE_URL",
        "NEXT_PUBLIC_PILOT_REALTIME_WS_URL",
        "NEXT_PUBLIC_SITE_URL",
        "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "NEXT_PUBLIC_SUPABASE_URL",
        "OPENAI_API_KEY",
        "OPENAI_FALLBACK_MODEL",
        "OPENAI_MODEL",
        "OPENAI_TRANSCRIPTION_MODEL"
      ],
      "outputs": [
        "dist/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
